<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Argoshot</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>Argoshot</PackageId>
    <Version>0.1.0</Version>
    <Authors>Argoshot</Authors>
    <Company>Argoshot</Company>
    <Description>Official client for the Argoshot screenshot API: screenshots, PDFs and signed og:image URLs of any web page or HTML.</Description>
    <PackageTags>argoshot;screenshot;screenshot-api;html-to-image;pdf;og-image</PackageTags>
    <PackageProjectUrl>https://argoshot.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rrlabs-io/argoshot-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 RRLabs</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
